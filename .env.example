# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# Models: Sonnet reads cards (~1.2 cents/card), Haiku interprets questions (~0.03 cents/query).
EXTRACT_MODEL=claude-sonnet-5-5
QUERY_MODEL=claude-haiku-5-5
# Cheap check that an upload really is a business card before the card is read.
CARD_GATE_MODEL=claude-haiku-5-5
# Re-run a card on a fallback model if Sonnet's safety classifier declines it.
EXTRACT_FALLBACKS=true

# Where databases and card photos are stored. Back this folder up.
DATA_DIR=./data

# First admin account, created on first start only if no users exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Keep true in production (HTTPS). Set to false only for plain-HTTP testing on a LAN.
COOKIE_SECURE=true
SESSION_DAYS=30
MAX_UPLOAD_MB=15

# Abuse limits, per user (0 disables a limit).
CARDS_PER_DAY=100
QUERIES_PER_DAY=300
AI_CALLS_PER_MINUTE=10
MAX_PENDING_JOBS=3
